{
	"name": "wsr-flash-card",
	"version": "4.5.0",
	"description": "A flashcard learning plugin for Obsidian based on FSRS algorithm",
	"keywords": [],
	"license": "0-BSD",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "vite build --watch --mode development",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"build": "npm run typecheck && vite build",
		"deploy": "npm run build && node scripts/deploy-icloud.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"release": "pnpm version --message \"chore(release): %s\" --tag-version-prefix \"\"",
		"release:patch": "pnpm release patch",
		"release:minor": "pnpm release minor",
		"release:major": "pnpm release major",
		"lint": "npm run typecheck && oxlint src",
		"lint:fix": "oxlint src --fix",
		"format": "oxfmt .",
		"format:check": "oxfmt . --check",
		"check:all": "npm run format:check && npm run lint && npm run test",
		"setup-hooks": "node scripts/setup-hooks.mjs",
		"prepare": "node scripts/setup-hooks.mjs"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"lucide-react": "^1.31.0",
		"obsidian": "^1.13.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"ts-fsrs": "^5.4.1"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"oxlint-tsgolint": "^7.0.2001",
		"tslib": "2.8.1",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	}
}
