{
	"name": "StudyStudio",
	"version": "4.9.0",
	"description": "A flashcard learning plugin for Obsidian based on FSRS algorithm",
	"keywords": [],
	"license": "0-BSD",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "vite build --watch --mode development",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"dictionary:engine": "cargo build --release --target wasm32-unknown-unknown -p dictionary-engine && wasm-bindgen target/wasm32-unknown-unknown/release/dictionary_engine.wasm --target web --out-dir src/dictionary/engine --out-name dictionary_engine",
		"build": "pnpm run typecheck && vite build",
		"deploy": "pnpm run build && node scripts/deploy-icloud.mjs",
		"version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
		"release": "pnpm version --message \"chore(release): %s\" --tag-version-prefix \"\"",
		"release:patch": "pnpm release patch",
		"release:minor": "pnpm release minor",
		"release:major": "pnpm release major",
		"lint": "pnpm run typecheck && oxlint src",
		"lint:fix": "oxlint src --fix",
		"format": "oxfmt .",
		"format:check": "oxfmt . --check",
		"check:all": "pnpm run format:check && pnpm run lint && pnpm run test",
		"setup-hooks": "node scripts/setup-hooks.mjs",
		"prepare": "node scripts/setup-hooks.mjs"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"lucide-react": "^1.40.0",
		"obsidian": "^1.13.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"ts-fsrs": "^5.4.2"
	},
	"devDependencies": {
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"oxlint-tsgolint": "^7.0.2001",
		"sass": "^1.104.0",
		"tslib": "2.8.1",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "pnpm@11.25.0"
}
